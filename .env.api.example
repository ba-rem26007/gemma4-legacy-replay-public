# Profil API (mise au point) : Google AI Studio — https://aistudio.google.com/apikey
# cp .env.api.example .env  puis renseigner la clé
COMP=gemma-4-developer-agent
KAGGLE_USER=ton_username
GEMMA_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# modèles dispo (agent/run.py --list-models) : gemma-4-31b-it, gemma-4-26b-a4b-it
LLM_MODEL=gemma-4-31b-it
BASE_MODEL=google/gemma-4-e4b-it
