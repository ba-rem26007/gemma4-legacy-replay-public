+        $unit = preg_replace('/[^bkmgt]/i', '', $size);
+        $size = preg_replace('/[^0-9\.]/', '', $size);
+        return $unit ? round($size * pow(1024, stripos('bkmgt', $unit))) : round($size);
+    }
+
+    protected function calculateMaxUploadSize()
+    {
+        return min(
+            (int)Configuration::get('PS_LIMIT_UPLOAD_IMAGE_VALUE') * 1024 * 1024,
+            $this->parsePhpSize(ini_get('upload_max_filesize')),
+            $this->parsePhpSize(ini_get('post_max_size'))
+        );
+    }
 
