+    public function delete()
+    {
+        if ($this->object && $this->object->main) {
+            $urls = ShopUrl::getShopUrls($this->object->id_shop);
+            if (count($urls) <= 1) {
+                $this->errors[] = $this->trans('You cannot delete the main URL of a shop if it is the only one.', [], 'Admin.Advparameters.Feature');
+                return false;
+            }
+
+            foreach ($urls as $url) {
+                if ($url->id != $this->object->id) {
+                    $url->setMain();
+                    break;
+                }
+            }
+        }
+
+        return parent::delete();
+    }
+
+    public function getUnremovableUrls()
+    {
+        $unremovable = [];
+        $shops = Shop::getShops(false, null, true);
+        foreach ($shops as $id_shop) {
+            $urls = ShopUrl::getShopUrls($id_shop);
+            if (count($urls) === 1) {
+                $url = reset($urls);
+                $unremovable[] = (int) $url->id;
+            }
+        }
+
+        return $unremovable;
+    }
