+    let unmatchingInvoicePriceExists = false;
+    let unmatchingProductPriceExists = false;
 
     productRows.forEach((productRow) => {
       const productRowId = $(productRow).attr('id');
@@ -89,11 +98,6 @@ export default class OrderPricesRefresher {
