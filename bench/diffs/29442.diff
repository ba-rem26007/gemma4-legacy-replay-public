+        return self::FILENAME_FILTERS_REGEX;
+    }
+
+    /**
+     * {@inheritdoc}
+     */
+    public function getTranslationDomains(): array
+    {
+        return self::TRANSLATION_DOMAINS_REGEX;
+    }
+}
