+      | total_discounts_tax_excl | 0.00  |
+      | total_discounts_tax_incl | 0.00  |
+      | total_shipping_tax_excl  | 7.0   |
+      | total_shipping_tax_incl  | 7.42  |
+      | total_paid_tax_excl      | 19.00 |
+      | total_paid_tax_incl      | 20.14 |
+      | total_paid               | 20.14 |
+      | total_paid_real          | 0.0   |
+    # total_products : 12 = 12 (+ 6% (0.72) = 12.72)
+    # total_discounts : 0
