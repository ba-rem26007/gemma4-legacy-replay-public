+            'http' => [true, 'http'],
+            'https' => [true, 'https'],
+            'uppercase is normalised' => [true, 'HTTPS'],
+            'ftp' => [true, 'ftp'],
+            'ftps' => [true, 'ftps'],
+            // curl is not allowed to speak these, so they must not pass validation either.
