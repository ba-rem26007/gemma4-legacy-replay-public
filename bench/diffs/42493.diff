+  "- 'Nightly tests and report - develop (mariadb)'" \
+  "Nightly tests and report - ${NEW} (mysql)" <<EOF
+      - 'Nightly tests and report - ${NEW} (mysql)'
+      - 'Nightly tests and report - ${NEW} (mariadb)'
+EOF
