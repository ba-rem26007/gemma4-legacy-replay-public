+        $customValuesMapping = [];
+        if (!empty($customFeatureValues)) {
+            $lastFeatureValueId = (int) $this->connection->createQueryBuilder()
+                ->from($this->dbPrefix . 'feature_value')
+                ->select('id_feature_value')
+                ->addOrderBy('id_feature_value', 'DESC')
+                ->executeQuery()
+                ->fetchOne()
+            ;
