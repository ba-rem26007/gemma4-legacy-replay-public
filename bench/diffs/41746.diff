-namespace PrestaShop\PrestaShop\Core\ExtraProperty;
-
-enum ExtraPropertyType: int
-{
-    case Int = 1;
-    case Bool = 2;
-    case String = 3;
-    case Float = 4;
-    case Date = 5;
-    case Html = 6;
-    case Json = 7;
-    case Choice = 8;
-}
