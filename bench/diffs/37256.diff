+    }
+
+    /**
+     * @return array<ModuleTechnicalName>
+     */
+    public function getModules(): array
+    {
+        return $this->modules;
+    }
+
+    /**
+     * @return bool
+     */
+    public function getDeteleFile(): bool
+    {
+        return $this->deleteFile;
+    }
+}
