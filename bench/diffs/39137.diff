+        $shipments = array_filter($shipments, fn (OrderShipment $s) => $s->getId() !== $shipmentId);
+
+        foreach ($products as &$p) {
+            $p = $p->toArray();
+        }
+
+        return [
+            'products' => $products,
+            'shipments' => $shipments,
+        ];
+    }
