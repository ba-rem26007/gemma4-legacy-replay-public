+/**
+ * Gets file extension from filepath
+ * test.example.jpg returns jpg
+ * test.example returns example
+ *
+ * @param $path
+ * @return array|string|string[]|null
+ */
+function getFileExtension($path)
+{
+    if (!is_file($path)) {
+        return null;
+    }
+
+    return pathinfo($path, PATHINFO_EXTENSION) ?: null;
+}
