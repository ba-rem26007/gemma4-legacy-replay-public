+    protected function getCasters()
+    {
+        $casters = [
+            '*' => function ($v, array $a, Stub $s, $isNested) {
+                if (!$v instanceof Stub) {
+                    $b = $a;
+                    foreach ($a as $k => $v) {
+                        if (!\is_object($v) || $v instanceof DateTimeInterface || $v instanceof Stub) {
+                            continue;
+                        }
+
+                        try {
+                            $a[$k] = $s = new CutStub($v);
