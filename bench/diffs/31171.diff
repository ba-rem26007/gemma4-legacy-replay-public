diff --git a/tests/Integration/Behaviour/Features/Scenario/Product/Combination/Shop/update_combination_suppliers_multishop.feature b/tests/Integration/Behaviour/Features/Scenario/Product/Combination/Shop/update_combination_suppliers_multishop.feature
