+    optionLabel: '.extra-property-options-editor__label',
+    optionInput: '.extra-property-options-editor__input',
+    optionRemove: '.extra-property-options-editor__remove',
+    inactiveZoneClass: 'extra-property-lang-zone--inactive',
+  },
+  // Shared dropdown chrome (suggestion dropdowns + the form field anchor tree).
+  dropdown: {
+    wrapClass: 'extra-property-anchor-wrap',
+    wrap: '.extra-property-anchor-wrap',
+    anchorWrap: '[data-role="anchor-wrap"]',
+    headingClass: 'extra-property-anchor-heading',
+    option: '.extra-property-anchor-option',
+    visibleOption: '.extra-property-anchor-option:not(.d-none)',
+    optionLabel: '.extra-property-anchor-option__label',
+    optionDetail: '.extra-property-anchor-option__path',
+    customOptionClass: 'extra-property-anchor-option--custom',
+    groupOptionClass: 'extra-property-anchor-option--group',
+    /** Tree indentation classes generated by SCSS (see the matching @for loop). */
+    depthClass: (depth: number): string => `extra-property-anchor-option--depth-${depth}`,
+  },
+  api: {
+    methodChips: '[data-role="method-chips"]',
+    allMethodsChip: '[data-role="all-methods"]',
+    endpointSearch: '[data-role="endpoint-search"]',
+    endpointSearchWrapper: '[data-role="endpoint-search-wrapper"]',
+  },
+  developer: {
+    formTypeInput: 'input[name$="[form_type]"]',
+    formOptionsTextarea: 'textarea[name$="[form_options]"]',
+    jsonStatus: '[data-role="json-status"]',
