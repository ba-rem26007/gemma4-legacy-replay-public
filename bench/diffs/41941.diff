diff --git a/src/PrestaShopBundle/Resources/config/services/extra_property/catalog.yml b/src/PrestaShopBundle/Resources/config/services/extra_property/catalog.yml
new file mode 100644
index 0000000000000..fc86c33b2e58d
--- /dev/null
+++ b/src/PrestaShopBundle/Resources/config/services/extra_property/catalog.yml
@@ -0,0 +1,56 @@
+# Catalog services for the Extra Property feature (Symfony kernels only, not the FO legacy container).
+#
+# They enumerate the back-office surfaces an extra property definition can be associated with
+# (grids, identifiable-object forms, Admin API endpoints) and expose a lazy per-form field tree,
+# to power the autocomplete UX of the Extra Property definition page.
+services:
+  _defaults:
+    autowire: true
+    autoconfigure: true
+    public: false
+
+  # Filesystem cache pool shared by every catalog below (and the admin-only endpoint catalog).
+  # It lives inside the Symfony kernel cache dir (these services are Symfony-only — ps_cache_dir
+  # is the legacy folder for services shared with the FO), so the cache:clear that module
+  # management already triggers wipes it — no dedicated invalidation is needed: the catalogs are
+  # bound to the deployed code and installed modules.
+  prestashop.extra_property.catalog.filesystem_cache:
+    class: Symfony\Component\Cache\Adapter\FilesystemAdapter
+    arguments:
+      - 'extra_property_catalog'
+      - 0
+      - '%kernel.cache_dir%'
+
+  # ─── Grid catalog ────────────────────────────────────────────────────────────
+  # The tagged locator is autowired via the #[AutowireLocator('core.grid_definition_factory')]
+  # constructor attribute (same pattern as GridDefinitionFactoryProvider).
+
+  PrestaShop\PrestaShop\Core\ExtraProperty\Catalog\GridCatalog:
+    arguments:
+      $logger: '@logger'
+      $cache: '@prestashop.extra_property.catalog.filesystem_cache'
+
+  # ─── Form catalog ────────────────────────────────────────────────────────────
+  # The form types parameter is built by IdentifiableObjectFormTypesCollectorPass (all environments).
+
+  PrestaShop\PrestaShop\Core\ExtraProperty\Catalog\FormCatalog:
+    arguments:
+      $identifiableObjectFormTypes: '%prestashop.core.form.identifiable_object.form_types%'
+      $logger: '@logger'
+      $cache: '@prestashop.extra_property.catalog.filesystem_cache'
+
+  # The Admin API endpoint catalog and its consumers (AssociationExistenceChecker, the Placement
+  # card form type) are defined in app/config/admin/services.yml ONLY: they need the OpenApi
+  # factory, which API Platform registers solely where enable_swagger is on — the admin kernel.
+
+  # ─── Form field tree provider ────────────────────────────────────────────────
+  # Form types with REQUIRED options cannot be introspected with an empty options array; the
+  # provider supplies sample values good enough to BUILD the known exceptions (the product edit
+  # form — no data is ever set), see FormFieldTreeProvider::introspectionOptions().
+
+  PrestaShop\PrestaShop\Core\ExtraProperty\Catalog\FormFieldTreeProvider:
+    arguments:
+      $logger: '@logger'
+      $cache: '@prestashop.extra_property.catalog.filesystem_cache'
+      $connection: '@doctrine.dbal.default_connection'
+      $dbPrefix: '%database_prefix%'
