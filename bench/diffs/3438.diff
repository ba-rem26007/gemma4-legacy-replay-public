diff --git a/install-dev/upgrade/php/ps1611_fill_old_order_invoice_shop_addresses.php b/install-dev/upgrade/php/ps1611_fill_old_order_invoice_shop_addresses.php
new file mode 100644
index 0000000000000..b941d36b84696
--- /dev/null
+++ b/install-dev/upgrade/php/ps1611_fill_old_order_invoice_shop_addresses.php
@@ -0,0 +1,36 @@
+<?php
+/*
