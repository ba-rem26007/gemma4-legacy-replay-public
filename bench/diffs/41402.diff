+        $handlingCost = $this->configuration->get('PS_SHIPPING_HANDLING');
+        if (!$handlingCost) {
+            return;
+        }
+
+        $context->setCost($context->getCost()->plus(new DecimalNumber((string) $handlingCost)));
+    }
+}
