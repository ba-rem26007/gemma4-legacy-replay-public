diff --git a/tests/Unit/Adapter/Carrier/ShippingCost/Provider/ConfigFreeShippingCriteriaProviderTest.php b/tests/Unit/Adapter/Carrier/ShippingCost/Provider/ConfigFreeShippingCriteriaProviderTest.php
