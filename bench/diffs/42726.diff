+            if ($property->isStatic()) {
+                continue;
+            }
+            $normalized[$property->getName()] = $property->isInitialized($value)
+                ? $this->toComparableForm($property->getValue($value))
+                : '#uninitialized';
+        }
+
+        return $normalized;
+    }
+}
