+        yield 'shop_url (singular tab)' => ['shop_url', 'AdminShopUrl'];
+        yield 'feature_flag (singular tab)' => ['feature_flag', 'AdminFeatureFlag'];
+
+        // Canonicalized entity names resolve through their canonical spelling: the map or
