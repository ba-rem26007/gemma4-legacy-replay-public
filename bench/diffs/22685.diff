diff --git a/classes/Cart.php b/classes/Cart.php
index 458cd9587d7ab..56c331ff39a28 100755
--- a/classes/Cart.php
+++ b/classes/Cart.php
@@ -5312,4 +5312,27 @@ private function alterSummaryForDisplay(array $summary, bool $refresh = false):
 
         return $summary;
     }
+
+    /**
+     * @param Cart $cart
+     *
+     * @return float
+     */
+    public function getCartTotalPrice()
+    {
+        $summary = $this->getSummaryDetails();
+
+        $id_order = (int) Order::getIdByCartId($this->id);
+        $order = new Order($id_order);
+
+        if (Validate::isLoadedObject($order)) {
+            $taxCalculationMethod = $order->getTaxCalculationMethod();
+        } else {
+            $taxCalculationMethod = Group::getPriceDisplayMethod(Group::getCurrent()->id);
+        }
+
+        return $taxCalculationMethod == PS_TAX_EXC ?
+            $summary['total_price_without_tax'] :
+            $summary['total_price'];
+    }
 }
