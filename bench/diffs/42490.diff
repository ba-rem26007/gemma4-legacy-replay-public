+        foreach ([self::RESTRICTED_PRODUCT_ID, self::LANG_PRODUCT_ID, self::REPRESENTATIVE_PRODUCT_ID] as $productId) {
+            foreach ([self::DEFAULT_SHOP_ID, self::$secondShopId, self::$thirdShopId] as $shopId) {
