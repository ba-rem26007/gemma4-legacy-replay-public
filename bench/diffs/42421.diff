diff --git a/tests/Unit/Core/ExtraProperty/ExtraPropertyWriterTest.php b/tests/Unit/Core/ExtraProperty/ExtraPropertyWriterTest.php
index b82cc47c92b6e..1a316f6340bc0 100644
--- a/tests/Unit/Core/ExtraProperty/ExtraPropertyWriterTest.php
