+                if ([] === $shopIds) {
+                    return 0;
+                }
+
+                return in_array(self::DEFAULT_SHOP_ID, $shopIds, true) ? self::DEFAULT_SHOP_ID : min($shopIds);
+            }
+        );
+
+        return $resolver;
+    }
