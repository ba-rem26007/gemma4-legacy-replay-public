diff --git a/src/PrestaShopBundle/Form/Admin/Improve/International/Locations/ChangeCountriesZoneType.php b/src/PrestaShopBundle/Form/Admin/Improve/International/Locations/ChangeCountriesZoneType.php
new file mode 100644
