diff --git a/tests/Integration/ApiPlatform/DisabledEndpointsTest.php b/tests/Integration/ApiPlatform/DisabledEndpointsTest.php
new file mode 100644
index 0000000000000..1be935d1fc97c
--- /dev/null
+++ b/tests/Integration/ApiPlatform/DisabledEndpointsTest.php
@@ -0,0 +1,130 @@
+<?php
+/**
+ * Copyright since 2007 PrestaShop SA and Contributors
+ * PrestaShop is an International Registered Trademark & Property of PrestaShop SA
+ *
+ * NOTICE OF LICENSE
+ *
+ * This source file is subject to the Open Software License (OSL 3.0)
