+        yield 'children tail' => ['All[Url]', ['name' => 'All', 'options' => null, 'children' => 'Url']];
+        yield 'both tails' => [
+            'Collection(allowExtraFields: true)[ name: NotBlank ]',
+            ['name' => 'Collection', 'options' => 'allowExtraFields: true', 'children' => ' name: NotBlank '],
