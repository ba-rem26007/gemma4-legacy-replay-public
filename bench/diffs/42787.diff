+
+    public function testParseAcceptsMixedNewlineAndCommaSeparators(): void
+    {
+        $this->assertCount(3, $this->parseValid("NotBlank, Email\nUrl"));
+    }
+
+    // -- parse(): rejections -----------------------------------------------------------------
+
+    public function testAnUnknownNameIsRejectedAndItsSiblingsAreKept(): void
+    {
