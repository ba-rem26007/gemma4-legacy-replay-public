+        $this->assertSingleRejection($decoded, 0, 1, '"Bogus"');
+        $this->assertStringContainsString(
+            'Allowed constraints: ' . implode(', ', ExtraPropertyConstraintGrammar::getAllowedNames()),
+            $decoded->getRejections()[0]['reason']
