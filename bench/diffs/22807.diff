+              margin-top: 1rem !important;
+            }
+          }
+        }
+      }
+    }
+
+    #modules_list_container_content {
+      .tab-pane {
+        @include media-breakpoint-down(sm) {
+          // stylelint-disable-next-line
+          overflow: scroll;
+        }
+      }
+    }
+  }
+}
