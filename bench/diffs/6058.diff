         $filename = PrestaShopAutoload::getCacheFileIndex();
         @mkdir(_PS_CACHE_DIR_);
 
-        if (!file_put_contents($filename, $content) !== false) {
+        if (!$this->dumpFile($filename, $content)) {
             Tools::error_log('Cannot write temporary file '.$filename);
