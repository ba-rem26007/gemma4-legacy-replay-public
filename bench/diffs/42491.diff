     public function getShopConstraint(): ShopConstraint
     {
+        if (Shop::getContext() === Shop::CONTEXT_ALL) {
+            return ShopConstraint::allShops();
+        }
+
+        // Shop::setContext(CONTEXT_GROUP, null) is legal and leaves the context group id
