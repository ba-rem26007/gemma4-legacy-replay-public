+    /** @var OrderDetailId */
+    private $orderDetailId;
+
+    public function __construct(int $shipmentId, int $orderDetailId)
+    {
+        $this->shipmentId = new ShipmentId($shipmentId);
+        $this->orderDetailId = new OrderDetailId($orderDetailId);
+    }
