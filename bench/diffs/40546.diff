diff --git a/src/PrestaShopBundle/Command/CheckTranslationFixtures.php b/src/PrestaShopBundle/Command/CheckTranslationFixtures.php
new file mode 100644
index 0000000000000..eecc6db48992e
--- /dev/null
+++ b/src/PrestaShopBundle/Command/CheckTranslationFixtures.php
@@ -0,0 +1,185 @@
+<?php
+/**
+ * Copyright since 2007 PrestaShop SA and Contributors
+ * PrestaShop is an International Registered Trademark & Property of PrestaShop SA
