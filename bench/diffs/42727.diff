diff --git a/tests/Integration/Adapter/Product/ProductGridDataFactoryDecoratorTest.php b/tests/Integration/Adapter/Product/ProductGridDataFactoryDecoratorTest.php
new file mode 100644
index 0000000000000..4755fc29f4669
--- /dev/null
