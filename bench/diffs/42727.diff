diff --git a/tests/Unit/Core/ExtraProperty/Validation/ExtraPropertyTypeCompatibilityValidatorTest.php b/tests/Unit/Core/ExtraProperty/Validation/ExtraPropertyTypeCompatibilityValidatorTest.php
new file mode 100644
