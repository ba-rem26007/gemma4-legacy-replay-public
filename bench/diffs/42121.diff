+          .filter(([key]) => key !== data.propertyName && key !== 'countryId')
+          .forEach(([key, expectedValue]) => {
+            expect(
+              jsonResponse[key],
+              `Property "${key}" should not have changed after patching "${data.propertyName}"`,
+            ).to.equal(expectedValue);
+          });
+
