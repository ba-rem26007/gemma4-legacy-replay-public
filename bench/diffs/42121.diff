+          city: 'city',
+          postCode: 'postCode',
+          homePhone: 'phone',
+          mobilePhone: 'mobilePhone',
+          company: 'company',
+          vatNumber: 'vatNumber',
+          other: 'other',
+          dni: 'dni',
+        };
