+      propertyValue: editAddressData.mobilePhone,
+      propertyType: 'string',
+      boField: 'mobilePhone',
+    },
+    {
+      propertyName: 'company',
+      propertyValue: editAddressData.company,
+      propertyType: 'string',
+      boField: 'company',
